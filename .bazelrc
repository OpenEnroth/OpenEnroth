# OpenEnroth Bazel configuration

# ─── Bzlmod ──────────────────────────────────────────────────────────────────

common --enable_bzlmod
# No committed lockfile - resolution happens against the live registry.
common --lockfile_mode=off

# ─── C++23 ───────────────────────────────────────────────────────────────────

build --cxxopt=-std=c++23
build --host_cxxopt=-std=c++23

# Windows/MSVC uses a different flag
build:windows --cxxopt=/std:c++latest
build:windows --host_cxxopt=/std:c++latest
build:windows --cxxopt=/Zc:__cplusplus  # Make __cplusplus reflect actual standard
build:windows --copt=/Zc:preprocessor  # Use standard-compliant preprocessor (required for NLOHMANN_JSON_PASTE variadic macros)
build:windows --copt=/D_USE_MATH_DEFINES  # Pull in M_PI and other <cmath> defines (MSVC extension)
build:windows --copt=/utf-8  # fmt and other libs require UTF-8 source encoding
build:windows --copt=/D_WINDOWS  # CMake adds this automatically for Windows targets; enables _fseeki64/_ftelli64 aliases
build:windows --features=static_link_msvcrt  # Use /MT instead of /MD to match prebuilt dep libs (CMake uses MultiThreaded runtime)

# ─── Global include paths (mirrors CMake's include_directories(src test)) ────
# Allows #include "Engine/..." and #include "Testing/..." without explicit deps.
# GCC/Clang use -I, MSVC uses /I.
build:linux --copt=-Isrc --copt=-Itest
build:macos --copt=-Isrc --copt=-Itest
build:windows --copt=/Isrc --copt=/Itest
build:android_base --copt=-Isrc

# FMT_USE_NONTYPE_TEMPLATE_ARGS enables the _cf literals used throughout OE. It has to be
# defined globally because the BCR fmt module doesn't set it, and every fmt include must see it.
build:linux --copt=-DFMT_USE_NONTYPE_TEMPLATE_ARGS
build:macos --copt=-DFMT_USE_NONTYPE_TEMPLATE_ARGS
build:windows --copt=/DFMT_USE_NONTYPE_TEMPLATE_ARGS
build:android_base --copt=-DFMT_USE_NONTYPE_TEMPLATE_ARGS

# ─── Compiler selection ───────────────────────────────────────────────────────
# Linux builds use the environment's default gcc; C++23 "deducing this" (P0847R7)
# needs GCC >= 14, so CI promotes gcc-14 via update-alternatives (runners default
# to gcc-13) and the dev container ships gcc-15. No version pins here — pinning
# paths in --action_env just forces every environment to install that exact version.

# ─── Disable strict header dep tracking ─────────────────────────────────────
# MSVC's /showIncludes causes Bazel to reject headers found via /Isrc but not
# declared as explicit deps. Disable on Windows only; GCC/Clang .d file tracking
# works correctly (all headers are declared in BUILD hdrs).
build:windows --features=-parse_showincludes

# ─── Warnings ────────────────────────────────────────────────────────────────

build:linux --copt=-Wall --copt=-Wno-error
build:macos --copt=-Wall --copt=-Wno-error
# Note: HACKING.md mandates warnings-as-errors. Enable --copt=-Werror once all
# BUILD files are written and clean.

# ─── Platform configs ────────────────────────────────────────────────────────

build --enable_platform_specific_config

# Linux
build:linux --copt=-fPIC
# Use ld.bfd instead of ld.gold — gold linker can't find libstdc++.so from the versioned GCC dir
build:linux --features=-use_gold_linker

# Linux x86 (32-bit)
build:linux_x86 --config=linux
build:linux_x86 --copt=-m32
build:linux_x86 --linkopt=-m32
# Identify this as a 32-bit build for select() in BUILD files (//bazel/platforms:linux_x86).
# We can't use --platforms= here (no 32-bit toolchain registered), so use --define instead.
build:linux_x86 --define=oe_build_arch=x86_32
# Use gold for linux_x86. bfd doesn't support --start-lib/--end-lib (Bazel's
# start_end_lib feature), and lld rejects 32-bit ELF when called via -fuse-ld=lld
# (GCC doesn't properly forward -m elf_i386 to lld). Gold supports both --start-lib
# and 32-bit ELF (elf_i386) natively.
build:linux_x86 --linkopt=-fuse-ld=gold

# Linux x86_64
build:linux_x86_64 --config=linux

# Linux arm64 — CI arm runners & arm64 dev containers.
build:linux_arm64 --config=linux

# macOS
build:macos --apple_platform_type=macos
# Use system make instead of rules_foreign_cc's bundled make binary for the
# configure_make()/cmake() deps (ffmpeg, SDL3, OpenAL).
build:macos --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_make_toolchain

# macOS arm64
build:darwin_arm64 --config=macos
build:darwin_arm64 --cpu=darwin_arm64
build:darwin_arm64 --macos_minimum_os=11.0
# LuaJIT's Makefile requires MACOSX_DEPLOYMENT_TARGET as an exported env var.
# --action_env propagates it into all build actions (including make() sandboxes).
build:darwin_arm64 --action_env=MACOSX_DEPLOYMENT_TARGET=11.0

# macOS x86_64
build:darwin_x86_64 --config=macos
build:darwin_x86_64 --cpu=darwin_x86_64
build:darwin_x86_64 --macos_minimum_os=10.15
build:darwin_x86_64 --action_env=MACOSX_DEPLOYMENT_TARGET=10.15

# Windows x86. Bazel 8 resolves toolchains from --platforms (legacy --cpu only
# renames the output dir); the define marks 32-bit builds for select() in
# injected BUILD files, same as linux_x86.
build:windows_x86 --config=windows
build:windows_x86 --platforms=//bazel/platforms:windows_x86_platform
build:windows_x86 --extra_toolchains=//bazel/platforms:windows_x86_cc_toolchain
build:windows_x86 --define=oe_build_arch=x86_32

# Windows x86_64
build:windows_x86_64 --config=windows

# Hermetic make/pkg-config, downloaded by bazel/rules/windows_tools.bzl
# (cmake and ninja come prebuilt from rules_foreign_cc on every platform).
# A windows build needs nothing beyond msvc + bazel + git.
# Bazel's default shell is a hardcoded c:/msys64 path; use git's bash instead.
# Non-standard git installs: override with --shell_executable on the command line.
build:windows --shell_executable="C:/Program Files/Git/usr/bin/bash.exe"
build:windows --extra_toolchains=@msys2//:make_toolchain
build:windows --extra_toolchains=@msys2//:pkgconfig_toolchain

# Android — NDK version 28.1.13356709 (matches CI)
# android_base: common flags inherited by all android_* configs
# Use system make instead of rules_foreign_cc's bundled make binary for the
# configure_make()/cmake() deps.
build:android_base --extra_toolchains=@rules_foreign_cc//toolchains:preinstalled_make_toolchain
# SDL3's android build compiles NDK-bundled sources (cpufeatures); the cmake()
# rule receives the path via -DANDROID_NDK=$ANDROID_NDK_HOME.
build:android_base --action_env=ANDROID_NDK_HOME
build:android_base --cxxopt=-std=c++23
build:android_base --host_cxxopt=-std=c++23
build:android_base --copt=-fPIC
build:android_base --copt=-Wall
build:android_base --copt=-Wno-error

build:android --config=android_base
build:android_arm64_v8a --config=android
# --platforms sets the TARGET platform for cc_binary() cross-compilation.
# --android_platforms only applies to android_binary() rules (APK builds).
build:android_arm64_v8a --platforms=//bazel/platforms:android_arm64_v8a_platform
build:android_armeabi_v7a --config=android
build:android_armeabi_v7a --platforms=//bazel/platforms:android_armeabi_v7a_platform
build:android_x86_64 --config=android
build:android_x86_64 --platforms=//bazel/platforms:android_x86_64_platform
build:android_x86 --config=android
build:android_x86 --platforms=//bazel/platforms:android_x86_platform

# Universal APK: all four ABIs in one //android/openenroth APK.
build:android_universal --config=android_base
build:android_universal --android_platforms=//bazel/platforms:android_arm64_v8a_platform,//bazel/platforms:android_armeabi_v7a_platform,//bazel/platforms:android_x86_64_platform,//bazel/platforms:android_x86_platform

# ─── Local disk cache ────────────────────────────────────────────────────────
# Content-addressed cache on local disk. Avoids rebuilding cmake() deps (zlib,
# libpng, SDL3, OpenAL) and other expensive actions when sources haven't changed.
# Shared across workspaces and Bazel versions on the same machine.
# Note: not ~/.cache/bazel, which is bazel's default output root on Linux.
build --disk_cache=~/.cache/bazel-disk
# Bound the disk cache so 10 matrix legs' uploads fit GitHub's 10G repo budget.
build --experimental_disk_cache_gc_max_size=800M
# Caches downloaded http_archive tarballs (avoids re-downloading on every clean).
build --repository_cache=~/.cache/bazel-repo

# ─── BuildBuddy remote cache + build event stream ────────────────────────────
# CI activates this and supplies the API key via
# --remote_header=x-buildbuddy-api-key=... (from repo secrets).
build:remote-cache --bes_backend=grpcs://remote.buildbuddy.io
build:remote-cache --bes_results_url=https://app.buildbuddy.io/invocation/
build:remote-cache --remote_cache=grpcs://remote.buildbuddy.io
build:remote-cache --remote_timeout=10m
# Build without the bytes: only metadata comes down; bazel run/test fetch
# what they execute on demand. zstd halves the transfer sizes.
build:remote-cache --remote_download_minimal
build:remote-cache --remote_cache_compression
build:remote-cache --build_metadata=REPO_URL=https://github.com/OpenEnroth/OpenEnroth
# Invocation pages are viewable without login - it's an open-source repo.
build:remote-cache --build_metadata=VISIBILITY=PUBLIC

# Flatpak sandbox build (distribution/linux/flatpak): libdwarf lives in /app.
build:flatpak --copt=-I/app/include --linkopt=-L/app/lib

# ─── Convenience ─────────────────────────────────────────────────────────────

# Linker choice (cmake's OE_USE_LD_MOLD/OE_USE_LD_LLD): opt-in, requires the
# linker to be installed. linux_x86 stays on gold, see above.
build:mold --linkopt=-fuse-ld=mold
build:lld --linkopt=-fuse-ld=lld

# ccache layer (cmake's OE_USE_CCACHE): opt-in for local dev, requires ccache.
# Hits on preprocessed sources, so it survives header edits that bazel's
# input hashing has to treat as misses. Uses the masquerade dir, so linux-only;
# macOS users can point CC at homebrew's libexec equivalent.
build:ccache --repo_env=CC=/usr/lib/ccache/gcc
# Unsandboxed so ccache can reach its cache dir (~ paths can't be sandboxed in).
build:ccache --spawn_strategy=local

build --verbose_failures
test --test_output=errors
