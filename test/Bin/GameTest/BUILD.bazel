load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Shared with //test/Bin/RetraceTest.
cc_library(
    name = "gametest_options",
    testonly = True,
    srcs = ["GameTestOptions.cpp"],
    hdrs = ["GameTestOptions.h"],
    visibility = ["//test/Bin/RetraceTest:__pkg__"],
    deps = [
        "//src/Application/Startup:application_startup",
        "//src/Library/Cli:library_cli",
    ],
)

# The MM7 game data comes via --test_env=OPENENROTH_MM7_PATH; it's original
# game assets, so treating it as a constant input keeps result caching honest.
cc_test(
    name = "OpenEnroth_GameTest",
    size = "enormous",
    srcs = [
        "GameTestCommon.cpp",
        "GameTestCommon.h",
        "GameTestMain.cpp",
        "GameTests_0000.cpp",
        "GameTests_0500.cpp",
        "GameTests_1000.cpp",
        "GameTests_1500.cpp",
        "GameTests_2000.cpp",
    ],
    args = [
        "--test-path",
        "test/Data",
        "--headless",
    ],
    data = ["//test:test_data"],
    shard_count = 8,
    visibility = ["//visibility:public"],
    deps = [
        ":gametest_options",
        "//src/Application:application",
        "//src/Engine:engine_impl",
        "//src/Library/Cli:library_cli",
        "//src/Library/Platform/Sdl:library_platform_main",
        "//src/Library/StackTrace:library_stack_trace",
        "//src/Library/Environment:library_environment",  # createStandardEnvironment() impl
        "//test/Testing/Game:testing_game",
        # Test-case libraries that need the full engine (linked into the game test
        # binary in the CMake build as well).
        "//src/Engine/Objects:test_engine_objects",
        "//src/Engine/Spells:test_engine_spells",
    ],
)
