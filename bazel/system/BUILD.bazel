# System dependency targets.
# All src/ targets reference these (e.g. //bazel/system:sdl3). Everything is built
# from source — there are no prebuilt dependency archives in the bazel build.

# ─── SDL3 ────────────────────────────────────────────────────────────────────

cc_library(
    name = "sdl3",
    deps = ["@sdl3_src//:sdl3"],
    visibility = ["//visibility:public"],
)

# ─── OpenAL ──────────────────────────────────────────────────────────────────

cc_library(
    name = "openal",
    deps = ["@openal_src//:openal"],
    visibility = ["//visibility:public"],
)

# ─── ZLIB ────────────────────────────────────────────────────────────────────

cc_library(
    name = "zlib",
    deps = ["@zlib//:zlib"],
    visibility = ["//visibility:public"],
)

# ─── PNG ─────────────────────────────────────────────────────────────────────

cc_library(
    name = "png",
    deps = ["@libpng//:libpng"],
    visibility = ["//visibility:public"],
)

# ─── FFmpeg ──────────────────────────────────────────────────────────────────
# The BCR ffmpeg module is a native-bazel port; its with_defaults/ variants enable
# the standard per-OS codec set (same as a stock ./configure). Its own CI covers
# linux x86_64/arm64 & macOS; we also use it for windows x86_64 and 64-bit android.
# 32-bit targets stay on the configure_make() source build: the module hardcodes
# x86-64 nasm sources for every non-aarch64 CPU.

cc_library(
    name = "ffmpeg",
    deps = select({
        "//bazel/platforms:linux_x86":           ["@ffmpeg_src//:ffmpeg"],
        "//bazel/platforms:android_armeabi_v7a": ["@ffmpeg_src//:ffmpeg"],
        "//bazel/platforms:windows_x86":         ["@ffmpeg_src//:ffmpeg"],
        "//conditions:default": [
            "@ffmpeg//:with_defaults/avcodec",
            "@ffmpeg//:with_defaults/avformat",
            "@ffmpeg//:with_defaults/avutil",
            "@ffmpeg//:with_defaults/swscale",
            "@ffmpeg//:with_defaults/swresample",
        ],
    }),
    visibility = ["//visibility:public"],
)

# ─── LuaJIT ──────────────────────────────────────────────────────────────────
# Windows: MSVC build via luajit-cmake (LuaJIT's own Makefile requires GCC).
# Other platforms: two-stage make() build from @luajit.

cc_library(
    name = "luajit",
    deps = select({
        "@platforms//os:windows": ["@luajit_win//:luajit"],
        "//conditions:default":   ["@luajit//:luajit"],
    }),
    visibility = ["//visibility:public"],
)

# ─── OpenGL ──────────────────────────────────────────────────────────────────
# System-provided on all platforms — no prebuilt archive needed.

cc_library(
    name = "opengl",
    linkopts = select({
        "@platforms//os:linux":   ["-lGL"],
        # Use -Wl,-framework,Name (single string) to avoid two-entry pair ordering
        # issues in Bazel 8+ linkopts handling.
        "@platforms//os:macos":   ["-Wl,-framework,OpenGL"],
        "@platforms//os:windows": ["opengl32.lib"],
        "@platforms//os:android": ["-lGLESv2", "-lEGL"],
        "//conditions:default":   [],
    }),
    visibility = ["//visibility:public"],
)
