# Bazel support files package.

# Per-platform dbg detectors for stdlib_hardening.bzl.
config_setting(
    name = "linux_dbg",
    constraint_values = ["@platforms//os:linux"],
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "macos_dbg",
    constraint_values = ["@platforms//os:macos"],
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "android_dbg",
    constraint_values = ["@platforms//os:android"],
    values = {"compilation_mode": "dbg"},
    visibility = ["//visibility:public"],
)

# Cpu detectors for detection.bzl. linux_x86 builds on the host x86_64
# platform with -m32 and marks itself with --define (see .bazelrc), so the
# extra define makes cpu_x86_32_shim a strict specialization of cpu_x86_64
# and keeps select() resolution unambiguous.
config_setting(
    name = "cpu_x86_64",
    constraint_values = ["@platforms//cpu:x86_64"],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "cpu_x86_32_shim",
    constraint_values = ["@platforms//cpu:x86_64"],
    define_values = {"oe_build_arch": "x86_32"},
    visibility = ["//visibility:public"],
)
