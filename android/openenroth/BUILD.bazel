load("@rules_android//android:rules.bzl", "android_binary", "android_library")

android_library(
    name = "java",
    srcs = ["src/main/java/org/openenroth/game/OpenEnroth.java"] + ["@sdl3_src//:android_java"],
    custom_package = "org.openenroth.game",
    manifest = "src/main/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
)

# lib<name>.so is the SDLActivity convention: it loads "main".
android_binary(
    name = "main",
    custom_package = "org.openenroth.game",
    manifest = "src/main/AndroidManifest.xml",
    manifest_values = {
        "applicationId": "org.openenroth.game",
        "minSdkVersion": "24",
        "targetSdkVersion": "31",
    },
    visibility = ["//visibility:public"],
    deps = [
        ":java",
        "//src/Bin/OpenEnroth:openenroth_apk_main",
    ],
)
