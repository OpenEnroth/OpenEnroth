load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "library_snd",
    srcs = [
        "SndReader.cpp",
        "SndSnapshots.cpp",
    ],
    hdrs = [
        "SndReader.h",
        "SndSnapshots.h",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/Library/Binary:library_binary",
        "//src/Library/Compression:library_compression",
        "//src/Library/Logger:library_logger",
        "//src/Library/Snapshots:library_snapshots",
        "//src/Utility:utility",
    ],
)

cc_library(
    name = "test_library_snd",
    testonly = True,
    srcs = [
        "Tests/SndReader_ut.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":library_snd",
        "//test/Testing/Unit:testing_unit",
    ],
    alwayslink = True,
)
