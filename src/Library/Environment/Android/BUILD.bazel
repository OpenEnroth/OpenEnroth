load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "library_environment_android",
    srcs = [
        "AndroidEnvironment.cpp",
    ],
    hdrs = [
        "AndroidEnvironment.h",
    ],
    target_compatible_with = ["@platforms//os:android"],
    visibility = ["//visibility:public"],
    deps = [
        "//src/Library/Environment/Interface:library_environment_interface",
        # SDL3 — Phase 5 TODO
        "//bazel/system:sdl3",
    ],
    # Eagerly linked: nothing references these objects until link time resolves
    # createStandardEnvironment(), and lazy --start-lib archives would drop them.
    alwayslink = True,
)
