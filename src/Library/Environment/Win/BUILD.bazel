cc_library(
    name = "library_environment_win",
    srcs = [
        "WinEnvironment.cpp",
    ],
    hdrs = [
        "WinEnvironment.h",
    ],
    deps = [
        "//src/Library/Environment/Interface:library_environment_interface",
        "//src/Utility:utility",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    # Registry access (advapi32) and CoTaskMemFree (ole32).
    linkopts = [
        "-DEFAULTLIB:advapi32.lib",
        "-DEFAULTLIB:ole32.lib",
    ],
    # Eagerly linked: nothing references these objects until link time resolves
    # createStandardEnvironment(), and lazy --start-lib archives would drop them.
    alwayslink = True,
    visibility = ["//visibility:public"],
)
