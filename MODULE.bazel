# lua-language-server for //:check_style_lua, same 3.19.1 that the cmake style
# workflow pinned - the lua sources are kept clean against this exact release,
# and different releases flag different diagnostics. The archive
# is a full install tree - bin/ finds main.lua, script/ and meta/ next to it,
# so the whole tree ships as the :files filegroup. Only the archive matching
# the build machine is ever downloaded.
_LLS_BUILD = """
filegroup(
    name = "files",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "binary",
    srcs = ["bin/lua-language-server"],
    visibility = ["//visibility:public"],
)
"""

http_archive(
    name = "lls_linux_x64",
    build_file_content = _LLS_BUILD,
    sha256 = "e9235d2d72ef55bc41cf8c99cda2ed64777682024b4bb81f5dea425060c5cbb8",
    url = "https://github.com/LuaLS/lua-language-server/releases/download/3.19.1/lua-language-server-3.19.1-linux-x64.tar.gz",
)

http_archive(
    name = "lls_linux_arm64",
    build_file_content = _LLS_BUILD,
    sha256 = "abd2572e8fc929dc838a81ffb8473c5bce0bf39bfe8edb4b120b3b623176ce83",
    url = "https://github.com/LuaLS/lua-language-server/releases/download/3.19.1/lua-language-server-3.19.1-linux-arm64.tar.gz",
)

http_archive(
    name = "lls_darwin_x64",
