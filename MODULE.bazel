"""OpenEnroth Bazel module definition."""

module(
    name = "openenroth",
    version = "0.0.0",
)

# ─── Core Bazel rules ────────────────────────────────────────────────────────

bazel_dep(name = "rules_cc", version = "0.2.17")

# Explicit dep for the py_binary loads in //bazel/cmrc (Bazel 9 drops autoload).
bazel_dep(name = "rules_python", version = "0.40.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# ─── Testing ─────────────────────────────────────────────────────────────────

bazel_dep(name = "googletest", version = "1.17.0")

# ─── Libraries from the Bazel Central Registry ───────────────────────────────
# Kept as close to the CMake-pinned versions as the registry allows.

# fmt is capped at 11.x: the CMake build pins 11.1.1, and fmt 12 fails to compile
# for 32-bit x86 (its uint128 fallback lacks operator~). spdlog 1.15.3 is the last
# version whose fmt dependency stays at 11.x under MVS.
bazel_dep(name = "fmt", version = "11.2.0")
bazel_dep(name = "spdlog", version = "1.15.3")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")
bazel_dep(name = "cli11", version = "2.6.2")
bazel_dep(name = "glm", version = "1.0.3")
bazel_dep(name = "fast_float", version = "8.2.4")
bazel_dep(name = "magic_enum", version = "0.9.8")
bazel_dep(name = "boost.lambda2", version = "1.90.0.bcr.1", repo_name = "lambda2")
bazel_dep(name = "zlib", version = "1.3.2")
bazel_dep(name = "libpng", version = "1.6.58")

# ─── rules_foreign_cc — wraps CMake/Make deps (used for LuaJIT, SDL3, etc.) ──

bazel_dep(name = "rules_foreign_cc", version = "0.11.1")

# Bazel 8 compatibility patches, see the per-patch comments below.
single_version_override(
    module_name = "rules_foreign_cc",
    patch_strip = 1,
    patches = [
        # glib_dev has an unused load("@rules_cc//...") that fails under Bazel 8
        # (rules_cc isn't a non-dev bazel_dep of rules_foreign_cc 0.11.1).
        "//bazel/patches:rules_foreign_cc_fix_glib.patch",
        # full_label() returns @@module+ canonical names that $(location) can't
        # resolve under Bazel 8 Bzlmod.
        "//bazel/patches:rules_foreign_cc_fix_full_label.patch",
        # pkgconfig_build.bzl crashes when the make toolchain is path-based
        # (make_data.target is None).
        "//bazel/patches:rules_foreign_cc_fix_pkgconfig.patch",
    ],
    version = "0.11.1",
)

# Expose the autoconfigured cc repo: //bazel/platforms:windows_x86_cc_toolchain
# wraps its unregistered x64->x86 msvc cross toolchain.
cc_configure = use_extension("@rules_cc//cc:extensions.bzl", "cc_configure_extension")
use_repo(cc_configure, "local_config_cc")

# Hermetic windows make/pkg-config/cmake - see bazel/rules/windows_tools.bzl.
windows_tools = use_extension("//bazel/rules:windows_tools.bzl", "windows_tools")
use_repo(windows_tools, "cmake_windows", "msys2")

register_toolchains(
    "@msys2//:make_toolchain",
    "@msys2//:pkgconfig_toolchain",
    "@cmake_windows//:cmake_toolchain",
)

# ─── Android ─────────────────────────────────────────────────────────────────

bazel_dep(name = "rules_android", version = "0.6.0")

# NDK C++ toolchains for all ABIs, resolved from ANDROID_NDK_HOME.
bazel_dep(name = "rules_android_ndk", version = "0.1.3")

# Patch: stub repo instead of fail() when ANDROID_NDK_HOME is unset, so
# non-android builds work without an NDK.
single_version_override(
    module_name = "rules_android_ndk",
    patch_strip = 1,
    patches = ["//bazel/patches:rules_android_ndk_stub_no_ndk.patch"],
    version = "0.1.3",
)

android_ndk_repository_extension = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension")
use_repo(android_ndk_repository_extension, "androidndk")

register_toolchains("@androidndk//:all")

